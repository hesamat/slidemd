{
  "name": "slidemd",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.8",
  "description": "Create presentations with Markdown - live editing, presenter view, code highlighting, math, diagrams, PPTX import, and AI-powered post-processing",
  "author": "Hesam Alizadeh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hesamat/html-presentation.git"
  },
  "homepage": "https://github.com/hesamat/html-presentation#readme",
  "bugs": {
    "url": "https://github.com/hesamat/html-presentation/issues"
  },
  "keywords": [
    "markdown",
    "presentations",
    "slides",
    "speaker-view",
    "code-highlighting",
    "math",
    "mermaid",
    "pptx-import",
    "ai",
    "self-contained"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:cli": "node tools/dev-server.mjs",
    "dev:vite": "vite",
    "build": "node tools/build.mjs -- docs/example/slides.md",
    "build-example": "node tools/build-example.mjs",
    "prepdf": "npx playwright install chromium",
    "pdf": "node tools/pdf.mjs slides.html",
    "preview": "npx http-server dist -p 8001 -c-1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "dompurify": "3.4.12",
    "emf-converter": "^1.5.0",
    "interactjs": "^1.10.27",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "mermaid": "^11.14.0",
    "pptxtojson": "^2.0.6",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "prettier": "^3.8.4",
    "prismjs": "^1.30.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
