{
  "name": "slidemd",
  "private": true,
  "type": "module",
  "description": "Create presentations with Markdown - live editing, presenter view, code highlighting, math, and diagrams",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs -- docs/example.md",
    "prepdf": "npx playwright install chromium",
    "pdf": "node tools/pdf.mjs",
    "preview": "npx http-server dist -p 8001 -c-1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.28.1",
    "interactjs": "^1.10.27",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "playwright": "^1.49.0",
    "prettier": "^3.8.4",
    "prismjs": "^1.30.0",
    "terser": "^5.44.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
